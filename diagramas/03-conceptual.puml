    - fieldValue: Object
    --
    + getResourceName(): String
    + getFieldName(): String
    + getFieldValue(): Object
  }

  class BusinessException {
    - mensaje: String
    --
    + getMensaje(): String
  }

  class GlobalExceptionHandler {
    + handleResourceNotFoundException(ex: ResourceNotFoundException): ResponseEntity
    + handleBusinessException(ex: BusinessException): ResponseEntity
    + handleValidationExceptions(ex: MethodArgumentNotValidException): ResponseEntity
    + handleGenericException(ex: Exception): ResponseEntity
  }
}

' ============================================
' RELACIONES ENTRE PACKAGES
' ============================================

' Model usa Enums
Model ..> Enums : usa

' Repository usa Model
Repository ..> Model : mapea

' Service usa Repository y DTO
Service ..> Repository : usa
Service ..> DTO : convierte

' Controller usa Service y DTO
Controller ..> Service : invoca
Controller ..> DTO : recibe/retorna

' Security usa Repository
Security ..> Repository : usa

' Controller usa Security
Controller ..> Security : autenticado_por

' Service usa Exception
Service ..> Exception : lanza

' ============================================
' NOTAS EXPLICATIVAS
' ============================================

note right of Model
  **Entidades JPA**
  - @Entity + @Table
  - Herencia JOINED para Vehiculo
  - Menu NO extiende BaseEntity
  - Relaciones FK con @ManyToOne, @OneToOne
  - Auditoría automática con @PrePersist/@PreUpdate
end note

note right of Enums
  **Enumeraciones**
  - @Enumerated(EnumType.STRING)
  - Almacenadas como texto en BD
  - Validación de valores permitidos
end note

note right of Repository
  **Interfaces JPA**
  - Extienden JpaRepository<Entity, Long>
  - Métodos derivados por nombre
  - Consultas automáticas sin SQL
end note

note right of DTO
  **Data Transfer Objects**
  - Separan API de entidades
  - *Request: datos de entrada
  - *Response: datos de salida
  - *DTO: CRUD estándar
end note

note right of Service
  **Capa de Negocio**
  - Interfaces + *ServiceImpl
  - Lógica de negocio
  - Conversión Entity ↔ DTO
  - Validaciones
end note

note right of Controller
  **REST API**
  - @RestController + @RequestMapping
  - Endpoints /api/{recurso}
  - Inyección de servicios
  - Respuestas HTTP estándar
end note

note right of Security
  **Spring Security**
  - HTTP Basic Auth
  - BCrypt para passwords
  - CORS configurado
  - Protección por roles
end note

note right of Exception
  **Manejo de Errores**
  - @ControllerAdvice
  - Respuestas estructuradas
  - Códigos HTTP apropiados
end note

@enduml
 