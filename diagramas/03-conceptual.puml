title Diagrama Conceptual - Arquitectura por Capas\nSistema de Parqueadero

' ============================================
' PACKAGE: MODEL (Entidades JPA)
' ============================================

package "model\n(Entidades JPA - @Entity)" as Model #E3F2FD {

  abstract class BaseEntity {
    - id: Long <<PK, auto>>
    - fechaCreacion: LocalDateTime
    - fechaActualizacion: LocalDateTime
    - activo: Boolean
    --
    + getId(): Long
    + setId(id: Long): void
    + getFechaCreacion(): LocalDateTime
    + setFechaCreacion(fecha: LocalDateTime): void
    + getFechaActualizacion(): LocalDateTime
    + setFechaActualizacion(fecha: LocalDateTime): void
    + getActivo(): Boolean
    + setActivo(activo: Boolean): void
    + prePersist(): void
    + preUpdate(): void
  }

  abstract class Persona {
    - identificacion: String <<unique, not null>>
    - nombre: String <<not null>>
    - telefono: String
    - correo: String <<unique, not null>>
    --
    + getIdentificacion(): String
    + setIdentificacion(id: String): void
    + getNombre(): String
    + setNombre(nombre: String): void
    + getTelefono(): String
    + setTelefono(telefono: String): void
    + getCorreo(): String
    + setCorreo(correo: String): void
  }

  class Cliente {
    - direccion: String
    --
    + getDireccion(): String
    + setDireccion(direccion: String): void
  }

  class Empleado {
    - codigoEmpleado: String <<unique, not null>>
    - cargo: String <<not null>>
    --
    + getCodigoEmpleado(): String
    + setCodigoEmpleado(codigo: String): void
    + getCargo(): String
    + setCargo(cargo: String): void
  }

  abstract class Vehiculo {
    - placa: String <<unique, not null>>
    - marca: String <<not null>>
    - modelo: String <<not null>>
    - color: String
    - tipoVehiculo: TipoVehiculo <<not null>>
    - cliente: Cliente <<FK, not null>>
    --
    + getPlaca(): String
    + setPlaca(placa: String): void
    + getMarca(): String
    + setMarca(marca: String): void
    + getModelo(): String
    + setModelo(modelo: String): void
    + getColor(): String
    + setColor(color: String): void
    + getTipoVehiculo(): TipoVehiculo
    + setTipoVehiculo(tipo: TipoVehiculo): void
    + getCliente(): Cliente
    + setCliente(cliente: Cliente): void
  }

  class Carro {
    - numeroPuertas: Integer
    --
    + getNumeroPuertas(): Integer
    + setNumeroPuertas(num: Integer): void
    + Carro() { tipoVehiculo = CARRO }
  }

  class Moto {
    - cilindraje: Integer
    - tieneMaletero: Boolean
    --
    + getCilindraje(): Integer
    + setCilindraje(cil: Integer): void
    + getTieneMaletero(): Boolean
    + setTieneMaletero(maletero: Boolean): void
    + Moto() { tipoVehiculo = MOTO }
  }

  class Camion {
    - numeroEjes: Integer
    - capacidadCarga: Double
    --
    + getNumeroEjes(): Integer
    + setNumeroEjes(ejes: Integer): void
    + getCapacidadCarga(): Double
    + setCapacidadCarga(cap: Double): void
    + Camion() { tipoVehiculo = CAMION }
  }

  class Sede {
    - nombre: String <<not null>>
    - direccion: String <<not null>>
    - ciudad: String <<not null>>
    --
    + getNombre(): String
    + setNombre(nombre: String): void
    + getDireccion(): String
    + setDireccion(direccion: String): void
    + getCiudad(): String
    + setCiudad(ciudad: String): void
  }

  class Zona {
    - nombre: String <<not null>>
    - descripcion: String
    - tipoZona: TipoZona <<not null>>
    - sede: Sede <<FK, not null>>
    --
    + getNombre(): String
    + setNombre(nombre: String): void
    + getDescripcion(): String
    + setDescripcion(desc: String): void
    + getTipoZona(): TipoZona
    + setTipoZona(tipo: TipoZona): void
    + getSede(): Sede
    + setSede(sede: Sede): void
  }

  class EspacioParqueo {
    - codigo: String <<unique, not null>>
    - ubicacion: String <<not null>>
    - estado: EstadoEspacio <<not null>>
    - tipoVehiculoPermitido: TipoVehiculo <<not null>>
    - zona: Zona <<FK, not null>>
    --
    + getCodigo(): String
    + setCodigo(codigo: String): void
    + getUbicacion(): String
    + setUbicacion(ubicacion: String): void
    + getEstado(): EstadoEspacio
    + setEstado(estado: EstadoEspacio): void
    + getTipoVehiculoPermitido(): TipoVehiculo
    + setTipoVehiculoPermitido(tipo: TipoVehiculo): void
    + getZona(): Zona
    + setZona(zona: Zona): void
  }

  class Tarifa {
    - tipoVehiculo: TipoVehiculo <<unique, not null>>
    - valorHora: Double <<not null>>
    - valorDia: Double
    - valorFraccion: Double
    --
    + getTipoVehiculo(): TipoVehiculo
    + setTipoVehiculo(tipo: TipoVehiculo): void
    + getValorHora(): Double
    + setValorHora(valor: Double): void
    + getValorDia(): Double
    + setValorDia(valor: Double): void
    + getValorFraccion(): Double
    + setValorFraccion(valor: Double): void
  }

  class Ticket {
    - codigoTicket: String <<unique, not null>>
    - horaEntrada: LocalDateTime <<not null>>
    - horaSalida: LocalDateTime
    - estado: EstadoTicket <<not null>>
    - total: Double <<not null>>
    - vehiculo: Vehiculo <<FK, not null>>
    - espacioParqueo: EspacioParqueo <<FK, not null>>
    --
    + getCodigoTicket(): String
    + setCodigoTicket(codigo: String): void
    + getHoraEntrada(): LocalDateTime
    + setHoraEntrada(hora: LocalDateTime): void
    + getHoraSalida(): LocalDateTime
    + setHoraSalida(hora: LocalDateTime): void
    + getEstado(): EstadoTicket
    + setEstado(estado: EstadoTicket): void
    + getTotal(): Double
    + setTotal(total: Double): void
    + getVehiculo(): Vehiculo
    + setVehiculo(vehiculo: Vehiculo): void
    + getEspacioParqueo(): EspacioParqueo
    + setEspacioParqueo(espacio: EspacioParqueo): void
  }

  class Pago {
    - monto: Double <<not null>>
    - metodoPago: MetodoPago <<not null>>
    - estado: EstadoPago <<not null>>
    - referencia: String
    - fecha: LocalDateTime <<not null>>
    - ticket: Ticket <<FK, not null, unique>>
    --
    + getMonto(): Double
    + setMonto(monto: Double): void
    + getMetodoPago(): MetodoPago
    + setMetodoPago(metodo: MetodoPago): void
    + getEstado(): EstadoPago
    + setEstado(estado: EstadoPago): void
    + getReferencia(): String
    + setReferencia(ref: String): void
    + getFecha(): LocalDateTime
    + setFecha(fecha: LocalDateTime): void
    + getTicket(): Ticket
    + setTicket(ticket: Ticket): void
  }

  class Factura {
    - numeroFactura: String <<unique, not null>>
    - subtotal: Double <<not null>>
    - impuesto: Double <<not null>>
    - total: Double <<not null>>
    - pago: Pago <<FK, not null, unique>>
    --
    + getNumeroFactura(): String
    + setNumeroFactura(num: String): void
    + getSubtotal(): Double
    + setSubtotal(subtotal: Double): void
    + getImpuesto(): Double
    + setImpuesto(impuesto: Double): void
    + getTotal(): Double
    + setTotal(total: Double): void
    + getPago(): Pago
    + setPago(pago: Pago): void
  }

  class Reserva {
    - codigoReserva: String <<unique, not null>>
    - fechaReserva: LocalDateTime <<not null>>
    - horaInicio: LocalDateTime <<not null>>
    - horaFin: LocalDateTime <<not null>>
    - estado: EstadoReserva <<not null>>
    - cliente: Cliente <<FK, not null>>
    - vehiculo: Vehiculo <<FK, not null>>
    - espacioParqueo: EspacioParqueo <<FK, not null>>
    --
    + getCodigoReserva(): String
    + setCodigoReserva(codigo: String): void
    + getFechaReserva(): LocalDateTime
    + setFechaReserva(fecha: LocalDateTime): void
    + getHoraInicio(): LocalDateTime
    + setHoraInicio(hora: LocalDateTime): void
    + getHoraFin(): LocalDateTime
    + setHoraFin(hora: LocalDateTime): void
    + getEstado(): EstadoReserva
    + setEstado(estado: EstadoReserva): void
    + getCliente(): Cliente
    + setCliente(cliente: Cliente): void
    + getVehiculo(): Vehiculo
    + setVehiculo(vehiculo: Vehiculo): void
    + getEspacioParqueo(): EspacioParqueo
    + setEspacioParqueo(espacio: EspacioParqueo): void
  }

  class Usuario {
    - username: String <<unique, not null>>
    - email: String <<unique, not null>>
    - password: String <<not null>>
    - rol: RolUsuario <<not null>>
    - cliente: Cliente <<FK, unique>>
    --
    + getUsername(): String
    + setUsername(username: String): void
    + getEmail(): String
    + setEmail(email: String): void
    + getPassword(): String
    + setPassword(password: String): void
    + getRol(): RolUsuario
    + setRol(rol: RolUsuario): void
    + getCliente(): Cliente
    + setCliente(cliente: Cliente): void
  }

  class Menu {
    - id: Long <<PK, auto>>
    - nombre: String <<not null>>
    - ruta: String
    - activo: Boolean <<not null>>
    - padre: Menu <<FK, nullable>>
    - hijos: List<Menu>
    --
    + getId(): Long
    + setId(id: Long): void
    + getNombre(): String
    + setNombre(nombre: String): void
    + getRuta(): String
    + setRuta(ruta: String): void
    + getActivo(): Boolean
    + setActivo(activo: Boolean): void
    + getPadre(): Menu
    + setPadre(padre: Menu): void
    + getHijos(): List<Menu>
    + setHijos(hijos: List<Menu>): void
    + agregarHijo(hijo: Menu): void
    + removerHijo(hijo: Menu): void
  }

  ' Herencia dentro de model
  BaseEntity <|-- Persona
  Persona <|-- Cliente
  Persona <|-- Empleado
  BaseEntity <|-- Vehiculo
  Vehiculo <|-- Carro
  Vehiculo <|-- Moto
  Vehiculo <|-- Camion
  BaseEntity <|-- Sede
  BaseEntity <|-- Zona
  BaseEntity <|-- EspacioParqueo
  BaseEntity <|-- Tarifa
  BaseEntity <|-- Ticket
  BaseEntity <|-- Pago
  BaseEntity <|-- Factura
  BaseEntity <|-- Reserva
  BaseEntity <|-- Usuario

  ' Relaciones FK dentro de model
  Cliente "1" -- "0..1" Usuario : posee >
  Cliente "1" -- "1..*" Vehiculo : registra >
  Cliente "1" -- "1..*" Reserva : realiza >
  Vehiculo "1" -- "1..*" Ticket : genera >
  Vehiculo "1" -- "1..*" Reserva : se_asocia >
  Sede "1" -- "1..*" Zona : contiene >
  Zona "1" -- "1..*" EspacioParqueo : organiza >
  EspacioParqueo "1" -- "1..*" Ticket : atiende >
  EspacioParqueo "1" -- "1..*" Reserva : reserva >
  Ticket "1" -- "0..1" Pago : liquida >
  Pago "1" -- "0..1" Factura : genera >
  Menu "0..1" -- "0..*" Menu : padre → hijos
}

' ============================================
' PACKAGE: ENUMS
' ============================================

package "enums\n(Enumeraciones)" as Enums #FFF9C4 {

  enum RolUsuario {
    ADMIN
    CLIENTE
  }

  enum TipoVehiculo {
    CARRO
    MOTO
    CAMION
  }

  enum TipoZona {
    CARROS
    MOTOS
    CAMIONES
    MIXTA
  }

  enum EstadoEspacio {
    DISPONIBLE
    OCUPADO
    RESERVADO
    INACTIVO
  }

  enum EstadoTicket {
    ABIERTO
    CERRADO
    FACTURADO
  }

  enum EstadoPago {
    PENDIENTE
    APROBADO
    RECHAZADO
    REEMBOLSADO
  }

  enum MetodoPago {
    EFECTIVO
    TARJETA
    TRANSFERENCIA
    QR
  }

  enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    CANCELADA
    VENCIDA
  }
}

' ============================================
' PACKAGE: REPOSITORY (Interfaces JPA)
' ============================================

package "repository\n(Interfaces JPA - JpaRepository)" as Repository #E8F5E9 {

  interface UsuarioRepository {
    + findByUsername(username: String): Optional<Usuario>
  }

  interface ClienteRepository {
    + findByIdentificacion(id: String): Optional<Cliente>
  }

  interface VehiculoRepository {
    + findByPlaca(placa: String): Optional<Vehiculo>
    + findByClienteId(clienteId: Long): List<Vehiculo>
    + countByClienteId(clienteId: Long): long
  }

  interface TicketRepository {
    + findByCodigoTicket(codigo: String): Optional<Ticket>
    + findByVehiculoId(vehiculoId: Long): List<Ticket>
  }

  interface PagoRepository {
    + findByTicketId(ticketId: Long): Optional<Pago>
  }

  interface FacturaRepository {
    + findByPagoId(pagoId: Long): Optional<Factura>
  }

  interface ReservaRepository {
    + findByClienteId(clienteId: Long): List<Reserva>
    + findByEspacioParqueoId(espacioId: Long): List<Reserva>
  }

  interface EspacioParqueoRepository {
    + findByCodigo(codigo: String): Optional<EspacioParqueo>
    + findByEstado(estado: EstadoEspacio): List<EspacioParqueo>
    + findByZonaId(zonaId: Long): List<EspacioParqueo>
  }

  interface SedeRepository {
    + findByNombre(nombre: String): Optional<Sede>
  }

  interface ZonaRepository {
    + findBySedeId(sedeId: Long): List<Zona>
  }

  interface TarifaRepository {
    + findByTipoVehiculo(tipo: TipoVehiculo): Optional<Tarifa>
  }

  interface EmpleadoRepository {
    + findByIdentificacion(id: String): Optional<Empleado>
    + findByCodigoEmpleado(codigo: String): Optional<Empleado>
  }

  interface MenuRepository {
    + findByPadreIsNull(): List<Menu>
    + findByPadreId(padreId: Long): List<Menu>
  }
}

